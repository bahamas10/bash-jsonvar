#!/usr/bin/env bash

. ./utils.bash || exit 1
. ../jsonvar.bash || exit 1

declare -a INDEXED_ARR
declare -A ASSOC_ARR
declare BASIC_VAR

invalid-indexed() {
	msg=$1
	expected_output=$2
	output=${ jsonvar -v INDEXED_ARR 2>/dev/null; } || exit 1
	is-equal "$msg" "$output" "$expected_output"
}

invalid-assoc() {
	msg=$1
	expected_output=$2
	output=${ jsonvar -v ASSOC_ARR 2>/dev/null; } || exit 1
	is-equal "$msg" "$output" "$expected_output"
}

invalid-basic() {
	msg=$1
	expected_output=$2
	output=${ jsonvar -v BASIC_VAR 2>/dev/null; } || exit 1
	is-equal "$msg" "$output" "$expected_output"
}

test-invalid() {
	declare -a INDEXED_ARR=(0 1 2 0xff foo bar baz)
	declare -i INDEXED_ARR
	invalid-indexed 'testing mixed arrays' \
		'[0, 1, 2, null, null, null, null]'
	declare +i INDEXED_ARR

	declare -A ASSOC_ARR=([foo]=0 [bar]=1 [baz]=0xff [bat]=foo)
	declare -i ASSOC_ARR
	invalid-assoc 'testing mixed assoc arrays' \
		'{"foo": 0, "bar": 1, "bat": null, "baz": null}'
	declare +i ASSOC_ARR

	BASIC_VAR='hello world'
	declare -i BASIC_VAR
	invalid-basic 'testing bad int' 'null'
	declare +i BASIC_VAR

	BASIC_VAR='INDEXED_ARR'
    declare -n BASIC_VAR
	invalid-basic 'testing nameref' 'null'
    declare +n BASIC_VAR

	BASIC_VAR='08'
	declare -i BASIC_VAR
	invalid-basic 'testing bad octal' 'null'
	declare +i BASIC_VAR

	BASIC_VAR=99999999999999999999999
	declare -i BASIC_VAR
	invalid-basic 'testing big number' 'null'
	declare +i BASIC_VAR

	BASIC_VAR=$'a\xffb'
	invalid-basic 'testing bad utf8' 'null'
}

test-invalid
